# Better Auth
BETTER_AUTH_SECRET=           # genera con: npx -y @better-auth/cli secret
BETTER_AUTH_URL=http://localhost:3000

# BD local (Drizzle / better-sqlite3). En producción se usa el binding D1.
DATABASE_URL=file:./dev.db

# Sentry (opcional) — DSN es público y puede usarse en el cliente
VITE_SENTRY_DSN=
# Solo para subir source maps en `npm run build` / deploy
SENTRY_AUTH_TOKEN=
